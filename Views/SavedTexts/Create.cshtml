
@model test_project.Models.SavedText

@{
    ViewData["Title"] = "New Text";
}

<style>
    .editor-area {
        display: block;
        box-sizing: border-box;
        width: 100%;
        margin: 0;
        padding: 8px;
        color: inherit;
        font-family: inherit;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        overflow-y: auto;
        border: 1px solid transparent;
        border-radius: 5px;
        background: transparent;
        box-shadow: none;
    }

    .editor-display {
        cursor: text;
    }

    .editor-display:hover {
        border-color: #ced4da;
    }

    .editor-input {
        display: none;
        outline: none;
        resize: none;
    }

    .editor-input:focus {
        border-color: #ced4da;
        box-shadow: none;
    }

    #titleDisplay,
    #titleInput {
        height: 48px;
        min-height: 48px;
        max-height: 48px;
        font-size: inherit;
        font-weight: inherit;
        line-height: normal;
    }

    #contentDisplay,
    #contentInput {
        height: 300px;
        min-height: 300px;
        max-height: 300px;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 400;
        line-height: 1.5;
    }

    .placeholder-text {
        color: #6c757d;
        opacity: 0.65;
    }

    #titleInput,
    #contentInput {
        color: inherit;
    }

    .save-status {
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>

<form asp-action="Create" method="post" id="createTextForm">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <h2>
        <span id="titleDisplay"
              class="editor-area editor-display placeholder-text"
              title="Click to enter the title">Untitled</span>

        <input asp-for="Title"
               id="titleInput"
               class="editor-area editor-input"
               maxlength="200"
               placeholder="Untitled"
               aria-label="Text title" />
    </h2>

    <span asp-validation-for="Title" class="text-danger"></span>
    <span id="titleError" class="text-danger"></span>

   

    <div class="card">
        <div class="card-body">
            <div id="contentDisplay"
                 class="editor-area editor-display placeholder-text"
                 title="Click to enter text content">Start typing your text here...</div>

            <textarea asp-for="Content"
                      id="contentInput"
                      class="editor-area editor-input"
                      placeholder="Start typing your text here..."
                      aria-label="Text content"></textarea>

            <span asp-validation-for="Content" class="text-danger"></span>
            <span id="contentError" class="text-danger"></span>
        </div>
    </div>

    <p id="saveStatus" class="save-status mt-2" aria-live="polite">
        Click the title or content to edit.
    </p>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Text</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const createForm = document.getElementById('createTextForm');

        const titleDisplay = document.getElementById('titleDisplay');
        const titleInput = document.getElementById('titleInput');

        const contentDisplay = document.getElementById('contentDisplay');
        const contentInput = document.getElementById('contentInput');

        const titleError = document.getElementById('titleError');
        const contentError = document.getElementById('contentError');
        const saveStatus = document.getElementById('saveStatus');

        function editTitle() {
            titleInput.value = titleDisplay.classList.contains('placeholder-text')
                ? ''
                : titleDisplay.textContent;

            titleDisplay.style.display = 'none';
            titleInput.style.display = 'block';
            titleInput.focus();
        }

        function editContent() {
            contentInput.value = contentDisplay.classList.contains('placeholder-text')
                ? ''
                : contentDisplay.textContent;

            contentDisplay.style.display = 'none';
            contentInput.style.display = 'block';
            contentInput.focus();
        }

        function showTitle() {
            const value = titleInput.value.trim();

            if (value) {
                titleDisplay.textContent = value;
                titleDisplay.classList.remove('placeholder-text');
            } else {
                titleDisplay.textContent = 'Untitled';
                titleDisplay.classList.add('placeholder-text');
            }

            titleInput.style.display = 'none';
            titleDisplay.style.display = 'block';
        }

        function showContent() {
            const value = contentInput.value;

            if (value.trim()) {
                contentDisplay.textContent = value;
                contentDisplay.classList.remove('placeholder-text');
            } else {
                contentDisplay.textContent = 'Start typing your text here...';
                contentDisplay.classList.add('placeholder-text');
            }

            contentInput.style.display = 'none';
            contentDisplay.style.display = 'block';
        }

        titleDisplay.addEventListener('click', editTitle);
        contentDisplay.addEventListener('click', editContent);

        titleInput.addEventListener('blur', showTitle);
        contentInput.addEventListener('blur', showContent);

        createForm.addEventListener('submit', function (event) {
            const title = titleInput.value.trim();
            const content = contentInput.value.trim();

            titleError.textContent = '';
            contentError.textContent = '';

            let isValid = true;

            if (!title) {
                titleError.textContent = 'Title is required.';
                isValid = false;
            }

            if (!content) {
                contentError.textContent = 'Text content is required.';
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault();

                if (!title) {
                    titleDisplay.style.display = 'none';
                    titleInput.style.display = 'block';
                    titleInput.focus();
                } else {
                    contentDisplay.style.display = 'none';
                    contentInput.style.display = 'block';
                    contentInput.focus();
                }

                saveStatus.textContent = 'Please complete the required fields.';
            }
        });

        titleInput.addEventListener('input', () => {
            titleError.textContent = '';
            saveStatus.textContent = '';
        });

        contentInput.addEventListener('input', () => {
            contentError.textContent = '';
            saveStatus.textContent = '';
        });
    </script>
}
